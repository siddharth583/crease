rules_version = '2';

// Who may read and change Crease's club data in Firestore (project crease-29555).
// Paste this into Firebase console › Firestore Database › Rules, then Publish.
//
// - The admin (siddharth@copancs.com) can do everything, and is the only one who can change who's in the club.
// - Anyone signed in with a copancs.com Google account can read everything (and so export it on their phone).
// - People the admin adds as 'scorer' (shown as Editor) can start matches and score them; once a match is finished only
//   the admin can change it. Only the admin changes the squad, sides, auctions and line-ups, or deletes a match.
// - Anyone signed in can ask to be an editor; only they and the admin can see their request.
// - Everyone in the club can set their own photo; the admin can set anyone's.
// - People the admin adds as 'viewer' (outside copancs.com) can read everything.
// - Nobody else can read or write anything.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && email() == 'siddharth@copancs.com';
    }
    function club() {
      return get(/databases/$(database)/documents/clubs/copan).data;
    }
    function inDomain() {
      return signedIn() && email().matches('.*@copancs[.]com$');
    }
    function role() {
      return club().members.get(email(), '');
    }
    function canRead() {
      return isAdmin() || inDomain() || (signedIn() && role() in ['scorer', 'viewer']);
    }
    function canWrite() {
      return isAdmin() || (signedIn() && role() == 'scorer');
    }

    match /clubs/copan {
      allow read: if isAdmin() || inDomain() || (signedIn() && email() in resource.data.members);
      allow create, update, delete: if isAdmin();
    }

    // Matches: editors (role 'scorer') add matches and score them while they're on; once a match is finished only the
    // admin can change it, and only the admin deletes one.
    match /clubs/copan/matches/{id} {
      allow read: if canRead();
      allow create: if canWrite() && request.resource.data.by == email();
      allow update: if signedIn() && request.resource.data.by == email() && (isAdmin()
        || (role() == 'scorer' && resource.data.get('finished', true) == false
            && request.resource.data.get('deleted', false) == false));
      allow delete: if isAdmin();
    }

    // The squad, the usual sides, auctions and line-ups: everyone in the club reads them, only the admin changes them.
    match /clubs/copan/shared/{doc} {
      allow read: if canRead();
      allow create, update: if isAdmin() && request.resource.data.by == email();
      allow delete: if isAdmin();
    }

    // Players' photos, one entry each, at full quality: under a player's email (they set or remove their own) or, for a
    // player with no email, under name:<their name> (the admin's). Everyone in the club sees them. Pictures only.
    match /clubs/copan/photos/{who} {
      allow read: if canRead();
      allow create, update: if (isAdmin() || (canRead() && email() == who))
        && request.resource.data.photo is string && request.resource.data.photo.size() < 1000000
        && request.resource.data.photo.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+')
        && request.resource.data.by == email();
      allow delete: if isAdmin() || (signedIn() && email() == who);
    }

    // Editor requests: anyone signed in can ask for themselves; only they and the admin see it; the admin answers.
    match /clubs/copan/requests/{who} {
      allow read: if isAdmin() || (signedIn() && email() == who);
      allow create, update: if signedIn() && email() == who && request.resource.data.email == who
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
      allow delete: if signedIn() && email() == who;
    }
  }
}
