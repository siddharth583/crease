# Supabase project (Settings → API). The publishable/anon key is meant to be public; the database only exposes the
# club functions from supabase/schema.sql. Copy this file to .env.local (git ignores it) and fill both in.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key
